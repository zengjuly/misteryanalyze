[Unit]
Description=Mystery Analyze Web UI (Streamlit)
After=network.target

[Service]
User=ai_runner
WorkingDirectory=/home/ai/ai_runner/stock/stock_analyzer
Environment="PATH=/home/ai/ai_runner/venv/bin"
# 敏感凭据（HITHINK_FINANCE_API_KEY 等）经 EnvironmentFile 注入，不入仓库
EnvironmentFile=/etc/mystery-web.env
Environment="MYSTERY_DB_PATH=/home/ai/ai_runner/stock/data/db/mystery_cache.db"
Environment="TDX_VIPDOC_DIR=/home/ai/ai_runner/stock/data/tdx_vipdoc"
Environment="SOURCE_REPORT_DIR=/home/ai/ai_runner/stock/data/logs/"
# --server.address 127.0.0.1 --server.port 18881 仅本地监听，
# 对外 HTTPS 由 Apache 反向代理（scripts/mystery-ssl.conf，复用 Nextcloud 证书）
ExecStart=/home/ai/ai_runner/venv/bin/streamlit run web/app.py --server.port 18881 --server.address 127.0.0.1 --server.headless true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
